{
  "name": "@richardyu114/moryn",
  "version": "0.2.0",
  "description": "Local-first memory, skill, and handoff layer for AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "moryn": "dist/cli.js",
    "moryn-agent-smoke": "scripts/agent-lifecycle-smoke.js",
    "moryn-dogfood-demo": "scripts/dogfood-demo-smoke.js",
    "moryn-upgrade-smoke": "scripts/upgrade-compat-smoke.js",
    "moryn-resilience-smoke": "scripts/sync-resilience-smoke.js",
    "moryn-conflict-smoke": "scripts/sync-conflict-smoke.js",
    "moryn-permission-smoke": "scripts/permission-recovery-smoke.js",
    "moryn-large-store-smoke": "scripts/large-store-smoke.js"
  },
  "keywords": [
    "agent",
    "memory",
    "mcp",
    "handoff",
    "cli",
    "local-first"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/agent-install-prompt.md",
    "docs/agent-workflow.md",
    "docs/contracts.md",
    "docs/dashboard.md",
    "docs/development.md",
    "docs/implementation-roadmap.md",
    "docs/moryn-design.md",
    "assets",
    "scripts/agent-lifecycle-smoke.js",
    "scripts/host-runtime-binding-smoke.js",
    "scripts/transcript-compact-safety-smoke.js",
    "scripts/official-host-handoff-smoke.js",
    "scripts/learning-inbox-smoke.js",
    "scripts/finalization-assurance-smoke.js",
    "scripts/release-readiness.ts",
    "scripts/dogfood-demo-smoke.js",
    "scripts/upgrade-compat-smoke.js",
    "scripts/sync-resilience-smoke.js",
    "scripts/sync-conflict-smoke.js",
    "scripts/permission-recovery-smoke.js",
    "scripts/large-store-smoke.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "release:check": "tsx scripts/release-check.ts",
    "release:readiness": "tsx scripts/release-readiness.ts",
    "smoke:agent-lifecycle": "node scripts/agent-lifecycle-smoke.js",
    "smoke:host-runtime-binding": "node scripts/host-runtime-binding-smoke.js",
    "smoke:transcript-compact-safety": "node scripts/transcript-compact-safety-smoke.js",
    "smoke:official-host-handoff": "node scripts/official-host-handoff-smoke.js",
    "smoke:learning-inbox": "node scripts/learning-inbox-smoke.js",
    "smoke:finalization-assurance": "node scripts/finalization-assurance-smoke.js",
    "smoke:dogfood-demo": "node scripts/dogfood-demo-smoke.js",
    "smoke:upgrade-compat": "node scripts/upgrade-compat-smoke.js",
    "smoke:sync-resilience": "node scripts/sync-resilience-smoke.js",
    "smoke:sync-conflict": "node scripts/sync-conflict-smoke.js",
    "smoke:permission-recovery": "node scripts/permission-recovery-smoke.js",
    "smoke:large-store": "node scripts/large-store-smoke.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Richardyu114/Moryn.git"
  },
  "bugs": {
    "url": "https://github.com/Richardyu114/Moryn/issues"
  },
  "homepage": "https://github.com/Richardyu114/Moryn#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
